# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the example, which is the documented reference for every variable and
# is what a fresh clone copies. Without this negation `.env*` swallows it, and
# `cp .env.example .env.local` fails on a clean checkout.
!.env.example

# local sqlite data (never publish listening history / secrets)
data/
*.db
*.db-journal

# setup wizard marker. Its presence IS the "this station is configured" flag, so
# it must never travel between machines — a checked-in marker would close the
# wizard on every fresh clone.
.setup-complete

# local deploy runbook (holds hostnames, IPs, secrets — never publish)
DEPLOY.md

# local deploy script (holds hostnames, paths — never publish)
/deploy.sh

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# check-script artifacts (throwaway sqlite client + generated test schema).
# The scripts remove these on exit; this covers interrupted runs.
/.test-client
/prisma/.gen-test.prisma
/prisma/.gen-sqlite.prisma
