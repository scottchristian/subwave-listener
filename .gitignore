# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the example, which is the documented reference for every variable and
# is what a fresh clone copies. Without this negation `.env*` swallows it, and
# `cp .env.example .env.local` fails on a clean checkout.
!.env.example

# local sqlite data (never publish listening history / secrets)
data/
*.db

# build stamp, written by deploy.sh from the local commit SHA and verified against
# the release tag on the host. Untracked by design: it describes a deployment,
# not a commit.
public/build-sha.txt
*.db-journal

# setup wizard marker. Its presence IS the "this station is configured" flag, so
# it must never travel between machines — a checked-in marker would close the
# wizard on every fresh clone.
.setup-complete

# local deploy runbook (holds hostnames, IPs, secrets — never publish)
DEPLOY.md

# local deploy script (holds hostnames, paths — never publish)
/deploy.sh

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Device working documents — design spec, capability rule, API contract,
# provisioning runbook, hardware notes, task list. These are the thinking space
# for the ESP32-P4 screen component, not deliverables: they change weekly, they
# reference half-built code, and nothing reads them but us. Same reasoning as
# DEPLOY.md and deploy.sh above.
#
# Only *.md is ignored. device/firmware/ is real source and WILL be committed —
# the specs graduate into docs/ when the component works.
/device/*.md

# check-script artifacts (throwaway sqlite client + generated test schema).
# The scripts remove these on exit; this covers interrupted runs.
/.test-client

# Rendered layout previews (npm run render:setup). Regenerable, and only
# meaningful next to the YAML they were drawn from.
/.preview
/prisma/.gen-test.prisma
/prisma/lite-client
/prisma/.gen-cache.prisma
/prisma/.gen-sqlite.prisma
