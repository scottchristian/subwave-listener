# Copy to .env.local and fill in. Never commit .env.local (see .gitignore).
#
# Most values below can also be set from the admin dashboard, which writes them
# back into this file. Environment variables are the fallback and, for a few of
# them, the only place they can live. docs/settings.md says which is which.

# --- Station identity ------------------------------------------------------
# Baked into the client bundle at BUILD time. Changing one needs a rebuild, not
# just a restart — and the admin panel's Station Identity card does that for
# you. lib/station.ts holds every one of these; the fallbacks there are neutral
# placeholders, not a real station.
NEXT_PUBLIC_STATION_NAME="My Station"
NEXT_PUBLIC_STATION_TAGLINE="Broadcasting beyond boundaries."
NEXT_PUBLIC_STATION_DESCRIPTION="A private internet radio station with an AI DJ."
NEXT_PUBLIC_STATION_ABOUT="A private internet radio station. Access is by invitation only — please sign in to listen to the live stream."
# Leave this alone unless you are serving the logo from somewhere unusual.
# /brand/logo.png resolves to your uploaded artwork if you have any and to the
# shipped placeholder if not, and it is the one that cannot go stale.
NEXT_PUBLIC_STATION_LOGO="/brand/logo.png"
# Public address of the SUB/WAVE host. The browser calls this directly for
# now-playing metadata and cover art, so it must be reachable from the
# internet — never a LAN address. Base only, no /api suffix; the app appends
# /api/... itself.
NEXT_PUBLIC_BACKEND_URL="https://radio.example.com"
# Fallback for the tip button until Admin → Support Button saves one. Blank
# hides the button.
NEXT_PUBLIC_DONATE_URL=""

# --- Auth ------------------------------------------------------------------
# The public URL of THIS app, no trailing slash. Sign-in breaks if this is
# wrong even by a character.
NEXTAUTH_URL="https://my-station.example.com"
# `openssl rand -base64 32`. Rotating it logs everyone out.
NEXTAUTH_SECRET=""
# From Google Cloud Console → Credentials → OAuth client ID (Web application).
# The redirect URI must be exactly <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# A sign-in matching this address is auto-approved as admin. Only ever your own.
ADMIN_EMAIL="you@example.com"

# --- Database --------------------------------------------------------------
# One engine at a time. DB_PROVIDER is the source of truth; when it is absent
# the URL scheme decides, and failing that SQLite.
DB_PROVIDER="sqlite"
# SQLite: a `file:` path. Prisma resolves a relative one against prisma/schema.prisma,
# NOT the project root — so "../data/app.db" is what puts the file in <project>/data.
# An absolute path (file:/var/lib/station/station.db) avoids the question.
# Postgres: a postgresql:// URL. Use a direct endpoint, not a pooler: the admin
# panel's permission rehearsal cannot authenticate a new role through a pooler.
DATABASE_URL="file:../data/app.db"
# Optional: keep a free-tier Postgres awake with a cheap SELECT 1 on a timer
# (Postgres only). Interval clamps to 30–3600s.
DB_KEEPALIVE="false"
DB_KEEPALIVE_SECONDS="300"

# --- Encryption ------------------------------------------------------------
# 32 bytes, hex or base64 — `openssl rand -hex 32`. Names, emails and donation
# supporter fields are AES-256-GCM encrypted at rest with this key, and the
# email column holds an HMAC blind index so sign-in still works.
#
# LOSE THIS AND EVERY NAME, EMAIL AND DONATION IS UNRECOVERABLE. Back it up
# somewhere other than the database.
PII_ENCRYPTION_KEY=""

# --- SUB/WAVE host (server-side) -------------------------------------------
# Admin → Sub/Wave Server overrides all of these at runtime. Keep the values
# here so a fresh install has them.
# The controller's public API base (server-to-server). /api is appended if missing.
SUBWAVE_API_URL="https://radio.example.com/api"
# The local Icecast relay that listeners actually play, e.g.
# http://127.0.0.1:8000/stream.mp3. This must be the RELAY, never the backend:
# pointing it at the backend replaces one upstream connection per listener.
SUBWAVE_STREAM_URL="http://127.0.0.1:8000/stream.mp3"
SUBWAVE_ADMIN_USER=""
SUBWAVE_ADMIN_PASS=""
# Listener-facing stream password. It must match the relay's master password
# and the controller's privacy.password. Drift between the three is the usual
# cause of "metadata flows, audio does not".
STATION_PASSWORD=""

# --- Web Push (admin alerts) -----------------------------------------------
# `npx web-push generate-vapid-keys`. Rotating orphans existing devices; they
# re-subscribe on the next admin visit.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Process ---------------------------------------------------------------
# This app's pm2 process name, and the account it runs as. There is deliberately
# no default for the name: it belongs to a deployment, not to the software, and a
# wrong one means a restart that never happens. The routes that restart the app
# refuse early when it is unset rather than reporting a restart that silently
# did nothing.
#
# Run pm2 AS THE ACCOUNT YOU NAME HERE. The app restarts itself through pm2, and
# a process can only restart its own user's processes — so if the app runs as one
# user and pm2 as another, every dashboard restart fails. docs/deployment.md
# Step 7 sets this up as the unprivileged "subwave-listener" account.
PM2_APP_NAME=""
# Absolute path to pm2, if it is not at /usr/bin/pm2.
PM2_BIN="/usr/bin/pm2"
# Where the admin panel rewrites the values above. Defaults to ./.env.local.
# STATION_ENV_FILE=""

# --- Spotify (platform link resolver, optional) ---------------------------
# No redirect URI needed — server-to-server token flow. Apple Music links need
# no keys at all. Without these, tracks still get a Spotify search link.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- Webhooks --------------------------------------------------------------
# Buy Me A Coffee is the only supported donation provider. The webhook secret
# from their dashboard, Settings → Webhook. Set here or in Admin → Support
# Button. A delivery is only accepted when it carries a valid HMAC-SHA256 of
# its own body, so a missing secret refuses everything.
BMAC_WEBHOOK_SECRET=""
