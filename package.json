{
  "name": "subwave-web-player",
  "version": "0.0.4",
  "private": true,
  "scripts": {
    "build": "node scripts/ensure-cache-client.mjs && node scripts/run-checks.mjs && tsc --noEmit && next build",
    "check": "npm run check:unit && npm run check:db",
    "check:activity": "node --import ./scripts/test-register.mjs scripts/check-activity.mts",
    "check:address": "node scripts/check-address-reach.mts",
    "check:auto": "node --import ./scripts/test-register.mjs scripts/check-auto-update.mts",
    "check:backup": "TEST_PRISMA_CLIENT=\"$PWD/.test-client\" node --import ./scripts/test-register.mjs scripts/check-backup.mts",
    "check:brandpaths": "node --import ./scripts/test-register.mjs scripts/check-brandpaths.mts",
    "check:db": "npm run --silent check:backup && npm run --silent check:update && npm run --silent check:auto && npm run --silent check:activity && npm run --silent check:still-listening && npm run --silent check:heartbeat && npm run --silent check:presence-live && npm run --silent check:schedule-run && npm run --silent check:session-cache && npm run --silent check:session-sqlite && npm run --silent check:lite-cache && npm run --silent check:listeners && npm run --silent check:session-prune && npm run --silent check:subwave",
    "check:db-provider": "node --import ./scripts/test-register.mjs scripts/check-db-provider.mts",
    "check:dbmigrate": "node --import ./scripts/test-register.mjs scripts/check-dbmigrate.mts",
    "check:duration": "node scripts/check-track-duration.mts",
    "check:envfile": "node --import ./scripts/test-register.mjs scripts/check-envfile.mts",
    "check:heartbeat": "node --import ./scripts/test-register.mjs scripts/check-heartbeat.mts",
    "check:keepalive": "node --import ./scripts/test-register.mjs scripts/check-keepalive.mts",
    "check:links": "node scripts/check-links.mjs",
    "check:listeners": "TEST_PRISMA_CLIENT=\"$PWD/.test-client\" node --import ./scripts/test-register.mjs scripts/check-listeners.mts",
    "check:lite-cache": "TEST_PRISMA_CLIENT=\"$PWD/.test-client\" node --import ./scripts/test-register.mjs scripts/check-lite-cache.mts",
    "check:pii": "node scripts/check-pii.mjs",
    "check:pii-crypto": "node --import ./scripts/test-register.mjs scripts/check-pii-crypto.mts",
    "check:presence-live": "node --import ./scripts/test-register.mjs scripts/check-presence-live.mts",
    "check:refs": "node scripts/check-station-refs.mjs",
    "check:relay": "node --import ./scripts/test-register.mjs scripts/check-relay.mts",
    "check:request": "node scripts/check-request-wait.mts",
    "check:schedule-run": "node --import ./scripts/test-register.mjs scripts/check-schedule-run.mts",
    "check:session-cache": "node --import ./scripts/test-register.mjs scripts/check-session-cache.mts",
    "check:session-prune": "TEST_PRISMA_CLIENT=\"$PWD/.test-client\" node --import ./scripts/test-register.mjs scripts/check-session-prune.mts",
    "check:session-sqlite": "TEST_PRISMA_CLIENT=\"$PWD/.test-client\" node --import ./scripts/test-register.mjs scripts/check-session-sqlite.mts",
    "check:setup": "node scripts/check-setup.mjs",
    "check:skip-visibility": "node --import ./scripts/test-register.mjs scripts/check-skip-visibility.mts",
    "check:station": "node --import ./scripts/test-register.mjs scripts/check-station.mts",
    "check:still-listening": "node --import ./scripts/test-register.mjs scripts/check-still-listening.mts",
    "check:still-listening-flow": "node --import ./scripts/test-register.mjs scripts/check-still-listening-flow.mts",
    "check:subwave": "TEST_PRISMA_CLIENT=\"$PWD/.test-client\" node --import ./scripts/test-register.mjs scripts/check-subwave.mts",
    "check:unit": "npm run --silent check:pii-crypto && npm run --silent check:db-provider && npm run --silent check:envfile && npm run --silent check:skip-visibility && npm run --silent check:brandpaths && npm run --silent check:relay && npm run --silent check:keepalive && npm run --silent check:still-listening-flow && npm run --silent check:station && npm run --silent check:dbmigrate && npm run --silent check:refs && npm run --silent check:links && npm run --silent check:setup && npm run --silent check:version && npm run --silent check:duration && npm run --silent check:address && npm run --silent check:request && npm run --silent check:pii",
    "check:update": "node --import ./scripts/test-register.mjs scripts/check-update.mts",
    "check:version": "node scripts/check-version-compare.mts",
    "dev": "node scripts/ensure-cache-client.mjs && next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "next": "16.3.5",
    "pg": "^8.13.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.4",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^5.22.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
