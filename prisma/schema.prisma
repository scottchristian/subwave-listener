generator client {
  provider = "prisma-client-js"
}

// The provider here is whatever the station is CURRENTLY running on, because
// the generated Prisma client is built from this file — a client generated
// from the sqlite block cannot talk to Postgres even when DATABASE_URL says
// otherwise, and every single query then fails at runtime. The cutover route
// rewrites this block alongside DATABASE_URL and DB_PROVIDER; gen-schema.mjs
// performs the same swap for one-off copies.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id @default(cuid())
  // Blind index (HMAC) of the address, NOT the address — see lib/pii.ts.
  // Every lookup by session email compares tokens and keeps working.
  email          String?         @unique
  emailEnc       String?
  emailVerified  DateTime?
  // Encrypted at rest (AES-256-GCM); decrypted on read.
  name           String?
  image          String?
  isApproved     Boolean         @default(false)
  isAdmin        Boolean         @default(false)
  // Granular booth permissions. Admin implies both; these let a non-admin
  // run the manual voice DJ or approve access without full admin rights.
  canUseDj       Boolean         @default(false)
  canApprove     Boolean         @default(false)
  // May execute Sub/Wave DJ skills from the Account menu. Off by default, and
  // the menu entry is not rendered at all without it — the feature is
  // invisible rather than merely refused. A run costs a real LLM+TTS call that
  // airs immediately, so this is opt-in per person.
  canUseSkills   Boolean         @default(false)
  hideLikeName   Boolean         @default(false)
  nickname       String?
  createdAt      DateTime        @default(now())
  accounts       Account[]
  donations      Donation[]
  sessions       Session[]
  songRequests   SongRequest[]
  streamSessions StreamSession[]
  songLikes      SongLike[]
  pushSubscriptions PushSubscription[]
  presenceHeartbeat PresenceHeartbeat?
  skillRuns      SkillRun[]
  // Screens this person set up, and screens whose firmware they uploaded.
  // Audit only — never read in an authorisation branch. SetNull, not Cascade,
  // so removing a staff account does not brick a wall display.
  devicesCreated Device[] @relation("DeviceCreatedBy")
  devicesUploaded Device[] @relation("DeviceUploadedBy")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StreamSession {
  id          String    @id @default(cuid())
  userId      String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  durationSec Int?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The open-session gate (presence, and the database cutover check) asks for
  // endTime IS NULL AND startTime >= now-10m, ordered by startTime. This table
  // only ever grows, so without this the gate scans every session ever opened.
  @@index([endTime, startTime])
  // Admin stats sorts the whole history by startTime; leading endTime above
  // cannot serve an unfiltered sort, so the bare column is needed too.
  @@index([startTime])
  // Cascade deletes and the admin user roster's eager load.
  @@index([userId])
}

model Donation {
  id             String   @id @default(cuid())
  userId         String?
  // Encrypted at rest; supporterEmailIdx keeps the webhook's user lookup
  // working by equality without storing the address.
  supporterName  String?
  supporterEmail String
  supporterEmailIdx String?
  amount         Float
  currency       String   @default("AUD")
  message        String?
  receivedAt     DateTime @default(now())
    // The provider's own id for this donation, when the payload carries one.
    // A captured webhook can be replayed, and every replay is money the station
    // never received — so a repeat has to be a no-op rather than a second row.
    // Nullable and unique: rows predating this, and payloads with no id, are
    // unaffected, and Postgres allows many NULLs under a unique index.
    externalId     String?  @unique
  user           User?    @relation(fields: [userId], references: [id])

  // The ticker reads the newest donations on a recurring host poll and the
  // admin list filters a date range; both sort by receivedAt.
  @@index([receivedAt])
  // Admin roster eager load, and the user-removal update that nulls userId.
  @@index([userId])
  // Created by the pii_encryption migration but never declared in the schema.
  // Declaring it here is what keeps Postgres in step: `db push` derives the
  // target from this datamodel, so an undeclared index exists in SQLite and is
  // silently absent from Postgres.
  @@index([supporterEmailIdx])
}

model Setting {
  key   String @id
  value String
}

model SongRequest {
  id        String   @id @default(cuid())
  userId    String
  song      String
  nameUsed  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The anti-spam cooldown is "this user's most recent request", so the
  // filter and the sort have to be served together.
  @@index([userId, createdAt])
}

model SongLike {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  title     String?
  artist    String?
  album     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  // The like count for the playing track, polled every 15s per tab. The
  // unique index above cannot serve this: userId is its leading column, so a
  // trackId-only filter never touches it.
  @@index([trackId, createdAt])
}

model SongLinkCache {
  trackId        String   @id // Maps to subsonic_id
  spotifyUrl     String?
  appleMusicUrl  String?
  explicit       Boolean? // Spotify explicit flag; null = not yet resolved
  resolvedAt     DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The device count is a userId-only filter, and cascades delete by userId.
  @@index([userId])
}

model PresenceHeartbeat {
  userId   String   @id
  lastSeen DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every presence poll asks for heartbeats newer than 5 minutes, newest
  // first — on the hottest endpoint in the app.
  @@index([lastSeen])
}


// One requested skill execution.
//
// A skill run is slow by nature — Sub/Wave blocks until the agent has written a
// line and TTS has rendered and queued it — so the browser never holds that
// request open. The front end POSTs, gets a row id back immediately, and polls
// this table; a background worker inside the server process does the waiting.
//
// `status` is a String rather than a Prisma enum because this schema has to
// generate for SQLite as well as Postgres, and Prisma enums are Postgres-only.
//
//   queued   — accepted, the worker has not started it
//   running  — the worker is inside the Sub/Wave call
//   aired     — queued to the station and on air now
//   deferred — rendered, held to the next track boundary
//   quiet    — the DJ ran and chose to stand down (a 200 upstream, not an error)
//   failed   — the call genuinely did not happen
//   unknown  — we stopped waiting without an answer. NOT the same as failed:
//              Sub/Wave has no cancellation and no status endpoint, so a restart
//              or a timeout here means the segment may still have aired.
model SkillRun {
  id         String    @id @default(cuid())
  userId     String
  skillName  String
  skillLabel String
  status     String    @default("queued")
  spoken     String?
  reason     String?
  error      String?
  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The worker claims the oldest queued row; the poll path reads one row by id.
  @@index([status, queuedAt])
  @@index([userId, queuedAt])
}


// A wall-mounted ESP32-P4 screen.
//
// A device is NOT a user. It has its own row, its own credential, and its own
// auth helper, and no path at any privilege level resolves a device request to a
// User. Admin permissions on PROVISIONING are separate from device permissions:
// an admin can create this row, and that authorises the creation and nothing
// after it. See device/capabilities.md for the full reasoning and the five ways
// a device drifts into being a person.
//
// The device's entire persistent state is its WiFi credentials and its token.
// Everything else it knows — branding, schedule, settings, artwork, window
// position — is cache, re-fetchable from the server at will.
//
// Every enum-shaped field here is a String, because this schema must generate for
// SQLite as well as Postgres and Prisma enums are Postgres-only (see SkillRun).
model Device {
  id String @id @default(cuid())

  // Stable hardware id, minted by the firmware and COMPILED INTO IT as an ESPHome
  // substitution. Null until a build completes: the row exists before its binary
  // does, which is what makes "flash didn't complete" a visible state rather than
  // a half-registered ghost.
  deviceId String? @unique

  // Operator-visible name. Nothing reads it for authorisation.
  name  String
  model String @default("jc8012p4a1")

  // ---- credentials -------------------------------------------------------
  // Single-use, 7-day TTL, minted at row creation. Delivered to the device
  // through the bind flow (server URL + bind code) rather than compiled into
  // the firmware, so one standard image serves every screen.
  claimToken   String?
  claimExpires DateTime?

  // Short human-readable code (e.g. "AB1-C23") shown in the admin panel and
  // typed into the device during setup. The device sends it to the bind
  // endpoint along with the server URL it was given, and receives the
  // deviceId + claimToken in return. Single-use: consumed on first bind.
  bindCode        String?   @unique
  bindCodeExpires DateTime?

  // sha256 of the long-lived bearer token. The raw token is returned exactly once,
  // at claim, and is never retrievable afterwards.
  tokenHash   String?
  rotatedAt   DateTime?

  // Rotation grace window. A device authenticates WITH the token being replaced,
  // so it cannot be handed a new one unless the old one keeps working long enough
  // to deliver it — a single-field write would strand the device permanently.
  // Both are accepted inside the window; the heartbeat response carries the new
  // token and the device swaps it into NVS.
  //
  // The cost is real and bounded: a stolen old token stays usable for the window.
  // Fifteen minutes is generous for a device that heartbeats every 60 seconds.
  prevTokenHash    String?
  prevTokenExpires DateTime?

  // ---- lifecycle ---------------------------------------------------------
  //   building  row exists, binary not uploaded yet
  //   claimed   claimed, not yet heard from
  //   active    heartbeating
  //   offline   lastSeenAt past the stale window
  //   revoked   credentials dead, row kept for the audit trail
  status String @default("building")

  buildStatus String    @default("building") // building | built | failed
  buildLog    String?
  firmwareSha String?
  builtAt     DateTime?
  firmwareVer String?
  lastSeenAt  DateTime?
  ip          String?
  rssi        Int?

  // ---- settings ----------------------------------------------------------
  // bumped by every admin change; the device reports what it actually applied.
  // The higher revision wins, and the admin panel shows the reported value, so
  // a device and an admin can never disagree without it being visible.
  settingsRev Int       @default(1)
  appliedRev  Int?
  orientation String    @default("landscape") // landscape | portrait
  themeMode   String    @default("auto")      // auto | day | night
  brightness  Int       @default(70)
  idleMode    String    @default("dim")       // stay | dim | off
  idleMin     Int       @default(15)
  idlePct     Int       @default(20)
  skipEnabled String    @default("1")

  // Server capability only, and off. A wall display rotates only when pressed,
  // so there is deliberately no device-facing control for this.
  rotateViews String @default("0")

  // ---- location and timezone ---------------------------------------------
  // timezone is captured automatically from the setup browser's
  // Intl.DateTimeFormat zone. lat/lon come from a one-tap geolocation prompt on
  // the same page, because a timezone gives solar noon but NOT latitude, and
  // sunrise needs latitude.
  timezone String @default("")
  lat      Float?
  lon      Float?

  // ---- audit only --------------------------------------------------------
  // Never read in an authorisation branch. SetNull rather than Cascade so
  // deleting a staff account does not take its screens with it.
  createdById  String?
  uploadedById String?
  createdBy    User?   @relation("DeviceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  uploadedBy   User?   @relation("DeviceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  // ---- shared firmware OTA ----------------------------------------------
  // Reported by firmware that understands the shared-release protocol. Every
  // image built before it leaves this false, which is what keeps those screens
  // working unchanged: the heartbeat skips OTA entirely when it is false.
  //
  // otaInstalledVersion is the version the RUNNING image reports, which is what
  // a boot confirmation is checked against. Device.firmwareVer above stays the
  // ESPHome project version and is deliberately not reused for this: the two
  // mean different things, and conflating them is how a screen ends up labelled
  // with a release it never booted.
  otaCapable          Boolean   @default(false)
  otaInstalledVersion String?
  otaInstalledSha     String?
  otaInstalledSlot    String?   // app0 | app1 — which OTA slot the image booted from
  otaInstalledAt      DateTime?

  otaAttempts DeviceOtaAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The admin list filters by status; the offline sweep asks for rows whose
  // lastSeenAt is older than the stale window, in that order.
  @@index([status])
  @@index([lastSeenAt])
}

// A published, immutable shared firmware release.
//
// WHY IMMUTABLE. Every screen installs the same bytes, so a release's identity is
// its sha256, not an editable row. The version is unique and the bytes behind it
// never change: re-uploading the same version with different bytes is refused
// rather than silently replacing the image a fleet is midway through installing.
//
// DESCRIPTOR VERSION MUST EQUAL RELEASE VERSION. That is checked at upload time.
// Without it a screen would boot an image whose own descriptor names a different
// release, and no boot report, rollback decision or audit could say which one is
// actually running. Firmware whose descriptor still carries the ESPHome project
// version is rejected with that reason rather than accepted under a label it does
// not claim for itself.
//
// ARTIFACTS ARE NEVER DELETED. A withdrawn release may still be pinned by an
// install in flight, and deleting the bytes would strand it mid-download. There is
// deliberately no delete path.
model FirmwareRelease {
  id String @id @default(cuid())

  // Dotted numeric, e.g. "1.15.0". Unique because a version names exactly one
  // artifact, and a second upload under the same name is either the same bytes
  // (idempotent) or a mistake (refused).
  version   String @unique
  sha256    String @unique
  sizeBytes Int

  // Relative to the firmware root, never absolute and never client-supplied.
  storageKey String
  filename   String

  // What the bytes say about themselves. Stored so a published release can be
  // audited without re-reading the artifact.
  descriptorProject String
  descriptorVersion String
  chipId            Int
  minChipRev        Int?
  maxChipRev        Int?

  // Audit only — plain column, never read in an authorisation branch.
  uploadedById String?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  withdrawnAt DateTime?

  attempts DeviceOtaAttempt[]

  @@index([createdAt])
}

// One device's attempt to install one shared release.
//
// THE NULLABLE UNIQUE RESERVATION. activeDeviceId holds the device id only while
// the attempt is live, and is nulled the moment it reaches a terminal phase. The
// unique index therefore permits exactly one live attempt per device while
// allowing unlimited history — SQLite and Postgres both treat NULLs as distinct.
// A plain "check then insert" would let two heartbeats that arrive together both
// pass the check, so the constraint, not the read, is what enforces the rule.
//
// PHASE IS A STRING for the same reason every other enum-shaped field here is:
// this schema must generate for SQLite as well as Postgres.
model DeviceOtaAttempt {
  id String @id @default(cuid())

  // The device's idempotency key from the explicit install tap. Repeating the
  // request — a lost response, a reboot — returns this same row.
  requestId String
  deviceId  String
  releaseId String

  // requested | accepted | downloading | verifying | installing | rebooting |
  // success | failure | rollback | unknown as decided by the screen. Terminal
  // states are succeeded, failed, rolled_back, unknown and rejected; `unknown`
  // is what silence ages into, never an assumption that it worked.
  phase String @default("requested")

  // See the model comment. Null once terminal.
  activeDeviceId String? @unique

  requestedAt  DateTime  @default(now())
  acceptedAt   DateTime?
  installingAt DateTime?
  rebootingAt  DateTime?
  finishedAt   DateTime?
  bootResult   String? // ok | rolled_back
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device  Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  release FirmwareRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([deviceId, requestId])
  @@index([deviceId, createdAt])
  @@index([releaseId])
  @@index([phase])
}
